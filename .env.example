# Copy this file to .env and replace every "change-me" value before deployment.
IMAGE_TAG=dev
ENVIRONMENT=development

DB_DATABASE=ayakun
DB_USERNAME=ayakun
DB_PASSWORD=change-me
DB_PORT=5432
DB_URL=postgresql+asyncpg://ayakun:change-me@postgres:5432/ayakun

REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_URL=redis://:change-me@redis:6379/0

RABBITMQ_DEFAULT_USER=ayakun
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_DEFAULT_VHOST=ayakun
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

CELERY_APP=execution.celery_app:celery_app
CELERY_BROKER_URL=amqp://ayakun:change-me@rabbitmq:5672/ayakun
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/1

SECRET_KEY=change-me-use-at-least-32-random-bytes
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-use-a-strong-admin-password
TOKEN_EXPIRATION_TIME=30
SOLO_RUN_BLOCKED_NODE_TYPES=if_else
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_SEARCH_MODEL=qwen-turbo
QWEN_SIMPLE_MODEL=qwen-turbo
QWEN_COMPLEX_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_COMPLEX_MODEL=deepseek-v4-pro
DEEPSEEK_SIMPLE_MODEL=deepseek-flash
# Admin: which provider/model to use for each stage
WEB_SEARCH_PROVIDER=serper
SIMPLE_LLM_PROVIDER=deepseek
SIMPLE_LLM_MODEL=deepseek-flash
COMPLEX_LLM_PROVIDER=deepseek
COMPLEX_LLM_MODEL=deepseek-v4-pro
ALLOWED_LLM_MODELS=deepseek-flash,deepseek-v4-flash,deepseek-v4-pro,qwen-turbo,qwen-plus

YOOKASSA_ACCOUNT_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/billing
INITIAL_TOKEN_BALANCE=100
COST_PROMPT_SIMPLE=100
COST_PROMPT_COMPLEX=300
COST_WEB_SEARCH=150
COST_TELEGRAM_SEND=5
RESERVE_TOKENS_PER_NODE=100
LLM_TOKENS_PER_1000=40
WEB_SEARCH_TOKENS=150
TELEGRAM_SEND_TOKENS=5
PAYMENT_TOKENS_PER_RUBLE=100
PAYMENT_CREDITS_PER_USD=500

GIGACHAT_AUTH_KEY=

BACKEND_PORT=8000
FRONTEND_PORT=3000
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
LOKI_PORT=3100
NUXT_API_BASE=http://backend:8000/api/v1
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_PATH=./deploy/certs/fullchain.pem
TLS_KEY_PATH=./deploy/certs/privkey.pem
