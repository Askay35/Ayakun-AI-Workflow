# Copy this file to .env and replace every "change-me" value before deployment.
IMAGE_TAG=dev
ENVIRONMENT=development

DB_DATABASE=yakun
DB_USERNAME=yakun
DB_PASSWORD=change-me
DB_PORT=5432
DB_URL=postgresql+asyncpg://yakun:change-me@postgres:5432/yakun

REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_URL=redis://:change-me@redis:6379/0

RABBITMQ_DEFAULT_USER=yakun
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_DEFAULT_VHOST=yakun
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

CELERY_APP=execution.celery_app:celery_app
CELERY_BROKER_URL=amqp://yakun:change-me@rabbitmq:5672/yakun
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/1

SECRET_KEY=change-me-use-at-least-32-random-bytes
TOKEN_EXPIRATION_TIME=30
LOGIN_CODE_EXPIRATION_TIME=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_SEARCH_MODEL=qwen-turbo
QWEN_SIMPLE_MODEL=qwen-turbo
QWEN_COMPLEX_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SIMPLE_LLM_PROVIDER=qwen
COMPLEX_LLM_PROVIDER=deepseek
ALLOWED_LLM_MODELS=qwen-turbo,qwen-plus,deepseek-chat

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/billing
INITIAL_TOKEN_BALANCE=1000
RESERVE_TOKENS_PER_NODE=100
LLM_TOKENS_PER_1000=1
WEB_SEARCH_TOKENS=5
TELEGRAM_SEND_TOKENS=1
PAYMENT_TOKENS_PER_RUBLE=10

BACKEND_PORT=8000
FRONTEND_PORT=3000
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_PATH=./deploy/certs/fullchain.pem
TLS_KEY_PATH=./deploy/certs/privkey.pem
