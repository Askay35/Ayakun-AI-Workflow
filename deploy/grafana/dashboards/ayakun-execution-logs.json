      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({service=\"worker\", event=\"node.succeeded\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Звенья выполнены",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "{service=~\"$service\"} | json | event=~\"$event\" | run_id=~\"$run_id\" | line_format \"{{.msg}}  credits={{.credits}}  usage_in={{.input_cache_miss_tokens}}/{{.output_tokens}}  {{.node_type}} {{.node_id}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Логи выполнения",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "{service=\"worker\", event=~\"node.started|node.succeeded|node.failed\"} | json | run_id=~\"$run_id\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Звенья: запуск, вывод, credits, usage",
      "type": "logs"
    }
