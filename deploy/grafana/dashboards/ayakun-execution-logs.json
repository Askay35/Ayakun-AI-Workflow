      "pluginVersion": "11.5.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({service=\"worker\", event=\"run.started\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
