      "pluginVersion": "11.5.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({service=~\"backend|worker\", event=~\"run.failed|node.failed\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Ошибки",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
