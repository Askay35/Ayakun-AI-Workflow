{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "percentChangeColorMode": "standard", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "11.5.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({service=\"worker\", event=\"run.started\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Запуски",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "percentChangeColorMode": "standard", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "11.5.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({service=\"worker\", event=\"run.succeeded\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Успешные",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "red", "mode": "fixed" } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "percentChangeColorMode": "standard", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "11.5.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({service=~\"backend|worker\", event=~\"run.failed|node.failed\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Ошибки",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "percentChangeColorMode": "standard", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "11.5.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({service=~\"backend|worker\", event=~\"http.inbound|http.outbound\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "HTTP запросы",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "id": 7,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "{service=~\"$service\", event=~\"http.inbound|http.outbound\"} | json | line_format \"{{.direction}} {{.method}} {{.path}}{{.url}}  status={{.status_code}}  {{.duration_ms}}ms\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "HTTP: входящие и исходящие",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "id": 5,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "{service=~\"$service\"} | json | event=~\"$event\" | line_format \"{{.msg}}  {{if .method}}{{.method}} {{.path}}{{.url}} status={{.status_code}} {{.duration_ms}}ms{{end}}{{if .credits}} credits={{.credits}}{{end}}{{if .node_type}} {{.node_type}} {{.node_id}}{{end}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Все логи",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "{service=\"worker\", event=~\"node.started|node.succeeded|node.failed|run.started|run.succeeded|run.failed\"} | json |~ \"$run_id\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Цепочки и звенья",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 40,
  "tags": ["ayakun", "logs"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Loki", "value": "Loki" },
        "hide": 0,
        "includeAll": false,
        "label": "Источник",
        "name": "datasource",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "allValue": "backend|worker|beat",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "hide": 0,
        "includeAll": true,
        "label": "Сервис",
        "multi": true,
        "name": "service",
        "options": [],
        "query": "label_values({service=~\"backend|worker|beat\"}, service)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "hide": 0,
        "includeAll": true,
        "label": "Событие",
        "multi": true,
        "name": "event",
        "options": [],
        "query": "label_values({service=~\"backend|worker|beat\"}, event)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "text": "", "value": "" },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "hide": 0,
        "includeAll": false,
        "label": "run_id (опц.)",
        "name": "run_id",
        "options": [],
        "query": "",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Ayakun: логи",
  "uid": "ayakun-execution-logs",
  "version": 2,
  "weekStart": ""
}
